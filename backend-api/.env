# Variables de entorno para XentraStock API
NODE_ENV=development
PORT=3001
DB_PATH=./src/database/xentrastock.db

# Configuración de CORS
CORS_ORIGIN=http://localhost:8080

# JWT Secret (cambiar en producción)
JWT_SECRET=xentrastock_jwt_secret_key_2025

# Rate Limiting - Configuración para desarrollo y producción
RATE_LIMIT_WINDOW_MS=60000          # 1 minuto (en milisegundos)
RATE_LIMIT_MAX_REQUESTS=1000        # 1000 requests por minuto para operaciones normales

# Logging
LOG_LEVEL=info